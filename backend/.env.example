# =============================================================================
# TPP Protocol Backend — Environment Variables
# Copy this to .env and fill in real values
# =============================================================================

# --- Database ---
DATABASE_URL=postgres://tpp:<your-postgres-password>@localhost:5432/tpp_protocol

# --- Solana RPC ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# --- Program ---
PROGRAM_ID=9iUeMGw14CaAiASMUruBMWRR5j7HcEXwthuN5pDAo3Qf
COLLATERAL_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- Keeper wallet (funded keypair that submits keeper txns) ---
KEEPER_KEYPAIR_PATH=~/.config/solana/id.json

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8080
CORS_ALLOWED_ORIGINS=*

# --- Indexer ---
# Slot to start indexing from (0 = latest)
INDEXER_START_SLOT=0

# --- Keeper intervals (seconds) ---
EPOCH_KEEPER_INTERVAL_SECS=60
LIQUIDATION_KEEPER_INTERVAL_SECS=30

# --- Oracle ---
# How often to poll Pyth prices (milliseconds)
ORACLE_POLL_INTERVAL_MS=2000

# --- Log level ---
RUST_LOG=info,tpp_api=debug,tpp_indexer=debug,tpp_keeper=debug

# --- JWT Secret (for future auth) ---
JWT_SECRET=change_me_in_production
