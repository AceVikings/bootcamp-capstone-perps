# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored and should never be committed.

# Solana RPC endpoint (devnet or mainnet-beta)
VITE_RPC_URL=https://api.devnet.solana.com

# Backend API base URL
VITE_API_URL=http://localhost:8080

# On-chain program ID (from contracts/target/deploy/)
VITE_PROGRAM_ID=<program-id>

# Test USDC mint address (devnet only)
VITE_USDC_MINT=<usdc-mint>
